---
import { BookOpen, Sparkles, User, FolderGit2, FlaskConical } from 'lucide-react';

import { AudioToggle } from './AudioToggle';
import { SearchModal } from './SearchModal';

interface Props {
  currentChapter?: string;
}

const { currentChapter = 'الفصل الأول' } = Astro.props;

---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center group-hover:bg-amber-500/20 group-hover:border-amber-500/40 transition-colors">
        <img src="/logo.svg" alt="شعار الاقتصاد الفطري" class="w-6 h-6" />
      </div>
      <div>
        <span class="text-lg sm:text-xl font-bold tracking-tight text-white block group-hover:text-amber-300 transition-colors">
          الاقتصاد الفطري
        </span>
        <span class="text-[10px] text-slate-400 block -mt-1 font-light">
          شروحات تفاعلية قابلة للاستكشاف
        </span>
      </div>
    </a>

    <!-- Navigation / Chapter Badge & Audio Toggle -->
    <div class="flex items-center gap-2.5 sm:gap-4">
      <a
        href="/"
        class="text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors hidden md:inline-flex items-center gap-1.5"
      >
        <BookOpen class="w-4 h-4 text-slate-400" />
        <span>فهرس التجارب</span>
      </a>

      <a
        href="/about"
        class="text-xs sm:text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-900 border border-transparent hover:border-slate-800"
      >
        <User class="w-3.5 h-3.5 text-cyan-400" />
        <span>منشئ المنصة</span>
      </a>

      <a
        href="/sandbox"
        class="text-xs sm:text-sm font-medium text-slate-300 hover:text-emerald-300 transition-colors inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-900 border border-transparent hover:border-slate-800"
      >
        <FlaskConical class="w-3.5 h-3.5 text-emerald-400" />
        <span>المخبر (Sandbox)</span>
      </a>

      <a
        href="/resources"
        class="text-xs sm:text-sm font-medium text-slate-300 hover:text-amber-300 transition-colors hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-900 border border-transparent hover:border-slate-800"
      >
        <FolderGit2 class="w-3.5 h-3.5 text-amber-400" />
        <span>المستودعات والمصادر</span>
      </a>

      <div class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-amber-300 hidden sm:flex items-center gap-1.5">
        <Sparkles class="w-3.5 h-3.5 text-amber-400" />
        <span>{currentChapter}</span>
      </div>

      <SearchModal client:load />
      <AudioToggle client:load />
    </div>
  </div>
</header>
