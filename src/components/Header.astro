---
import { Compass, BookOpen, GitBranch, Sparkles } from 'lucide-react';

interface Props {
  currentChapter?: string;
}

const { currentChapter = 'الفصل الأول' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform">
        <Compass class="w-5 h-5 text-slate-950" />
      </div>
      <div>
        <span class="text-lg sm:text-xl font-bold tracking-tight text-white block group-hover:text-amber-300 transition-colors">
          الاقتصاد الفطري
        </span>
        <span class="text-[10px] text-slate-400 block -mt-1 font-light">
          شروحات تفاعلية قابلة للاستكشاف
        </span>
      </div>
    </a>

    <!-- Navigation / Chapter Badge -->
    <div class="flex items-center gap-3 sm:gap-6">
      <a
        href="/"
        class="text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors hidden md:inline-flex items-center gap-1.5"
      >
        <BookOpen class="w-4 h-4 text-slate-400" />
        <span>فهرس التجارب الـ 5</span>
      </a>

      <div class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-amber-300 flex items-center gap-1.5">
        <Sparkles class="w-3.5 h-3.5 text-amber-400" />
        <span>{currentChapter}</span>
      </div>
    </div>
  </div>
</header>
