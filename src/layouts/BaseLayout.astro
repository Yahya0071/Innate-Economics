---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  currentChapter?: string;
}

const {
  title = 'منصة «الاقتصاد الفطري» | شروحات قابلة للاستكشاف',
  description = 'استكشف جوهر الاقتصاد بحدسك اليومي وقراراتك المباشرة بدون تلقين أو تعقيد أكاديمي.',
  currentChapter,
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#080c14" />

    <!-- PWA Webmanifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- KaTeX Mathematical Typography -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen bg-[#080c14] text-slate-100 antialiased selection:bg-amber-500/30 selection:text-amber-200">
    <!-- Ambient subtle background grid and radial glows -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
      <div class="absolute -top-40 right-1/4 w-[600px] h-[600px] bg-amber-500/5 rounded-full blur-[120px]"></div>
      <div class="absolute top-1/2 left-10 w-[500px] h-[500px] bg-cyan-500/5 rounded-full blur-[120px]"></div>
    </div>

    <Header currentChapter={currentChapter} />

    <main class="w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-slate-800/80 mt-20 py-12 bg-slate-950/60 text-slate-400 text-xs">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-3">
        <p class="font-medium text-slate-300">
          منصة «الاقتصاد الفطري» — تجربة تعليمية حية مستلهمة من فلسفة الشروحات القابلة للاستكشاف (Explorable Explanations).
        </p>
        <p class="text-slate-400">
          ابتكار وتطوير: <a href="/about" class="text-cyan-400 hover:text-cyan-300 font-semibold underline underline-offset-4 decoration-cyan-500/30">يحيى سراس (Yahya Sras)</a> — باحث في الاقتصاد والتمويل.
        </p>
        <p class="text-slate-500">
          مبني بفصل كامل بين محركات المحاكاة الرياضية الصرفة (<code class="text-slate-400">Pure TypeScript</code>) وطبقة السرد التفاعلي (<code class="text-slate-400">MDX + React Islands</code>).
        </p>
        <p class="text-slate-600 text-[11px] pt-2">
          جميع النماذج الرياضية مفتوحة ومختبرة بحزم اختبارات Vitest الصارمة.
        </p>
      </div>
    </footer>
  </body>
</html>
