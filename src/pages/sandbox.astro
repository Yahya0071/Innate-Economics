---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  FlaskConical,
  Sparkles,
  ArrowLeft,
  Users,
  LineChart,
  Fingerprint,
  Compass,
  Cpu,
} from 'lucide-react';
import { AgentEconomySimulation } from '../components/simulations/AgentEconomySimulation';
import { InteractiveEquilibriumCurve } from '../components/curves/InteractiveEquilibriumCurve';
import { DecisionFingerprint } from '../components/narrative/DecisionFingerprint';
---

<BaseLayout
  title="المخبر الاقتصادي التجريبي (Sandbox) | منصة الاقتصاد الفطري"
  description="مخبر تفاعلي مفتوح لاختبار نماذج الاقتصاد الكلي، محاكاة الوكلاء وتفاوت الثروة التلقائي (قانون باريتو)، وتحريك منحنيات العرض والطلب باللمس والسحب."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-14">
    <!-- Breadcrumb -->
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-400 hover:text-amber-400 transition-colors group"
      >
        <span class="p-1.5 rounded-lg bg-slate-900 border border-slate-800 group-hover:border-amber-500/40 transition-colors">
          <ArrowLeft class="w-4 h-4 rotate-180" />
        </span>
        <span>العودة إلى الفهرس الرئيس</span>
      </a>

      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 flex items-center gap-1.5">
          <FlaskConical class="w-3.5 h-3.5" />
          <span>المخبر التفاعلي الحر (Sandbox Mode)</span>
        </span>
      </div>
    </div>

    <!-- Hero Section -->
    <section class="glass-panel rounded-3xl p-6 sm:p-10 border-slate-800 relative overflow-hidden shadow-2xl">
      <div class="absolute -top-24 -left-24 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-xs font-semibold">
          <FlaskConical class="w-4 h-4" />
          <span>Experimental Laboratory & Visual Sandbox</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          المخبر الاقتصادي
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-cyan-300 to-amber-300 block sm:inline sm:mr-3">
            الحر والتجريبي
          </span>
        </h1>

        <p class="text-slate-300 text-sm sm:text-base font-light leading-relaxed max-w-3xl">
          هنا تنتقل من قراءة الفصول السردية إلى دور <strong class="text-white font-medium">الباحث التجريبي</strong>. في هذا المخبر، يمكنك تغيير المتغيرات، اختبار ظهور تفاوت الثروة التلقائي بين 60 وكيلاً ذكياً، سحب منحنيات العرض والطلب باللمس الحي، وإصدار جواز سفرك الاقتصادي المعتمد.
        </p>

        <!-- Quick Jump Tabs -->
        <div class="flex flex-wrap items-center gap-3 pt-3 text-xs">
          <a
            href="#agent-economy"
            class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-amber-300 transition-colors flex items-center gap-2"
          >
            <Users class="w-4 h-4 text-amber-400" />
            <span>1. محاكاة الوكلاء وتفاوت باريتو</span>
          </a>
          <a
            href="#equilibrium-curves"
            class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-cyan-300 transition-colors flex items-center gap-2"
          >
            <LineChart class="w-4 h-4 text-cyan-400" />
            <span>2. المنحنيات التفاعلية (Mafs)</span>
          </a>
          <a
            href="#decision-radar"
            class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-emerald-300 transition-colors flex items-center gap-2"
          >
            <Fingerprint class="w-4 h-4 text-emerald-400" />
            <span>3. الرادار الخماسي وجواز السفر</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Lab 1: Agent-Based Economy -->
    <section id="agent-economy" class="space-y-4">
      <div class="flex items-center gap-2.5 text-amber-400 text-xs font-semibold uppercase tracking-wider">
        <Sparkles class="w-4 h-4" />
        <span>المحطة الأولى: النمذجة القائمة على الوكلاء</span>
      </div>
      <AgentEconomySimulation client:load />
    </section>

    <!-- Lab 2: Interactive Mafs Curves -->
    <section id="equilibrium-curves" class="space-y-4">
      <div class="flex items-center gap-2.5 text-cyan-400 text-xs font-semibold uppercase tracking-wider">
        <Sparkles class="w-4 h-4" />
        <span>المحطة الثانية: المنحنيات الرياضية التفاعلية الحية</span>
      </div>
      <InteractiveEquilibriumCurve client:load />
    </section>

    <!-- Lab 3: Decision Radar & Economic Passport -->
    <section id="decision-radar" class="space-y-4">
      <div class="flex items-center gap-2.5 text-emerald-400 text-xs font-semibold uppercase tracking-wider">
        <Sparkles class="w-4 h-4" />
        <span>المحطة الثالثة: بطاقة البصمة الخماسية وجواز السفر الرسمي</span>
      </div>
      <DecisionFingerprint
        client:load
        chapterId="sandbox"
        chapterTitle="المخبر الاقتصادي التجريبي"
        metrics={{ timeScore: 85, commonsScore: 90, riskScore: 70 }}
        statItems={[
          { label: 'المرونة السلوكية', value: '94%' },
          { label: 'كفاءة القرارات', value: 'A+' },
          { label: 'مستوى الأمان', value: 'متوازن' },
          { label: 'التصنيف الفطري', value: 'مستثمر رصين' },
        ]}
      />
    </section>
  </div>
</BaseLayout>
