---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  GraduationCap,
  BookOpenCheck,
  Sparkles,
  Compass,
  ExternalLink,
  MapPin,
  Binary,
  Award,
  ArrowLeft,
  CheckCircle2,
  Building2,
  Bookmark,
} from 'lucide-react';
---

<BaseLayout
  title="عن منشئ المنصة | يحيى سراس — منصة الاقتصاد الفطري"
  description="تعرف على يحيى سراس، باحث في الاقتصاد والتمويل ومبتكر منصة الاقتصاد الفطري. رؤية أكاديمية قياسية تترجم صرامة الرياضيات إلى حدس بصري وتطبيقي."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-14">
    <!-- Top Breadcrumb & Return -->
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-400 hover:text-amber-400 transition-colors group"
      >
        <span class="p-1.5 rounded-lg bg-slate-900 border border-slate-800 group-hover:border-amber-500/40 transition-colors">
          <ArrowLeft class="w-4 h-4 rotate-180" />
        </span>
        <span>العودة إلى الفهرس الرئيس</span>
      </a>

      <span class="px-3 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/20">
        الملف الأكاديمي والبحثي
      </span>
    </div>

    <!-- Hero Profile Section -->
    <section class="glass-panel rounded-3xl p-6 sm:p-10 border-slate-800 relative overflow-hidden shadow-2xl">
      <!-- Glow ambient lights -->
      <div class="absolute -top-24 -left-24 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-8">
        <!-- Monogram / Avatar Badge -->
        <div class="relative shrink-0">
          <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-gradient-to-tr from-cyan-600 via-slate-900 to-amber-500 p-1 shadow-2xl shadow-cyan-950/50">
            <div class="w-full h-full bg-[#080c14] rounded-[22px] flex flex-col items-center justify-center text-center p-3 border border-slate-700/50">
              <span class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-amber-200 via-slate-100 to-cyan-300 font-mono">
                YS
              </span>
              <span class="text-[9px] text-slate-400 tracking-wider uppercase mt-1 font-mono">
                Researcher
              </span>
            </div>
          </div>
          <div class="absolute -bottom-2 -right-2 p-1.5 rounded-xl bg-slate-950 border border-amber-500/40 text-amber-400 shadow-md">
            <Award class="w-4 h-4" />
          </div>
        </div>

        <!-- Bio Header Details -->
        <div class="flex-1 text-center md:text-right space-y-3">
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
            <h1 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">
              يحيى سراس
            </h1>
            <span class="text-sm sm:text-base font-light text-slate-400 font-mono" dir="ltr">
              (Yahya Sras)
            </span>
          </div>

          <p class="text-sm sm:text-base text-cyan-300 font-medium">
            باحث في الاقتصاد القياسي والتطبيقي ومبتكر منصة «الاقتصاد الفطري»
          </p>

          <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs text-slate-400 pt-1">
            <span class="inline-flex items-center gap-1.5">
              <MapPin class="w-3.5 h-3.5 text-rose-400" />
              <span>جدة، المملكة العربية السعودية</span>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Building2 class="w-3.5 h-3.5 text-cyan-400" />
              <span>ماجستير في الاقتصاد والتمويل</span>
            </span>
          </div>

          <!-- Academic Profiles / Social Buttons -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-4">
            <!-- Google Scholar -->
            <a
              href="https://scholar.google.com/citations?user=mm4CW4UAAAAJ"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-cyan-950/70 hover:bg-cyan-900/90 text-cyan-300 border border-cyan-800/50 hover:border-cyan-500/50 transition-all shadow-sm group"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
              </svg>
              <span>Google Scholar</span>
              <ExternalLink class="w-3 h-3 text-cyan-500 group-hover:translate-x-0.5 transition-transform" />
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/yahya-sras"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/60 hover:border-slate-500 transition-all shadow-sm group"
            >
              <svg class="w-4 h-4 fill-current text-sky-400" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>الملف المهني (LinkedIn)</span>
              <ExternalLink class="w-3 h-3 text-slate-400 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The Philosophical Mission -->
    <section class="bg-gradient-to-br from-amber-500/10 via-slate-900/60 to-slate-950 border border-amber-500/20 rounded-3xl p-6 sm:p-10 shadow-xl space-y-4">
      <div class="flex items-center gap-2 text-amber-400 text-xs font-semibold uppercase tracking-wider">
        <Sparkles class="w-4 h-4" />
        <span>رؤية المنصة وفلسفتها</span>
      </div>

      <h2 class="text-xl sm:text-2xl font-bold text-white leading-snug">
        لماذا صُممت منصة «الاقتصاد الفطري»؟
      </h2>

      <p class="text-slate-300 leading-relaxed font-light text-sm sm:text-base">
        في قاعات الجامعات وصفحات المراجع الأكاديمية، يُحاصر علم الاقتصاد أحياناً بأسوار من التجريد الرياضي الجاف والرموز التي توحي للمتلقي بأنه علم منفصل عن واقع الناس. لكن الحقيقة الجوهرية هي أن <strong class="text-amber-200 font-semibold">الاقتصاد هو سيرة السلوك الإنساني اليومي</strong>؛ هو علم الندرة، وكيف يقرر الفرد قضاء ساعات يقظته، وكيف يدخر قوته لغده، وكيف تستجيب الأسواق للحوافز الفطرية.
      </p>

      <p class="text-slate-400 leading-relaxed font-light text-sm sm:text-base">
        أُنشئت هذه المنصة لتكون جسراً تفاعلياً حياً يستلهم فلسفة <strong class="text-slate-200">«الشروحات القابلة للاستكشاف» (Explorable Explanations)</strong>؛ حيث لا يتلقى القارئ النظريات تلقيناً، بل يختبرها بيده، ويحرّك مدخلاتها، ويرى بأم عينه كيف تتحول المبادئ الاقتصادية البسيطة إلى قوانين تحكم مجتمعات وأسواقاً بأكملها، مستندةً إلى محركات رياضية دقيقة لا تتنازل عن الصرامة الأكاديمية.
      </p>
    </section>

    <!-- Research Publications & Working Papers (Featured Full-Width Section) -->
    <section class="glass-panel rounded-3xl p-6 sm:p-9 border-slate-800 hover:border-amber-500/30 transition-all space-y-6 shadow-xl">
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-2xl bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <BookOpenCheck class="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-white">الإنتاج البحثي والأوراق العلمية المحكّمة</h3>
            <span class="text-xs text-slate-400">أبحاث ودراسات قياسية في الاقتصاد والتمويل مدعمة بمعرفات الأغراض الرقمية (DOI)</span>
          </div>
        </div>

        <span class="text-[11px] font-mono text-amber-400/90 bg-amber-950/60 px-3 py-1 rounded-lg border border-amber-800/40">
          Peer-Reviewed Research
        </span>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Paper 1: Saudi VAT Response (2026) -->
        <div class="bg-slate-950/80 p-5 sm:p-6 rounded-2xl border border-slate-800/90 space-y-3 hover:border-amber-500/30 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
                بحث منشور (2026)
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Saudi Economic Association</span>
            </div>
          </div>

          <div class="space-y-1">
            <h4 class="text-base sm:text-lg font-bold text-white leading-snug">
              قياس استجابة الإنفاق الاستهلاكي لمضاعفة ضريبة القيمة المضافة 2020 في السعودية: أدلة معاملات نقاط البيع الأسبوعية
            </h4>
            <p class="text-xs font-mono text-slate-400" dir="ltr">
              Measuring the Spending Response to Saudi Arabia's 2020 VAT Tripling: Weekly Point-of-Sale Evidence
            </p>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed font-light">
            <strong class="text-slate-200">وعاء النشر:</strong> مجلة الدراسات الاقتصادية، الجمعية الاقتصادية السعودية، جامعة الملك سعود.
          </p>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            استقصاء قياسي تجريبي عالي التردد يرصد تحولات سلوك المستهلك السعودي استجابةً للرفع الضريبي، من خلال نمذجة السلاسل الزمنية لبيانات نقاط البيع (POS).
          </p>
        </div>

        <!-- Paper 2: House Price Convergence (Master's Thesis Research) -->
        <div class="bg-slate-950/80 p-5 sm:p-6 rounded-2xl border border-slate-800/90 space-y-3 hover:border-cyan-500/30 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
                أطروحة وبحث قياسي
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Spatial Econometrics</span>
            </div>

            <!-- DOI Link -->
            <a
              href="https://doi.org/10.13140/RG.2.2.27355.49443"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-mono text-cyan-300 bg-cyan-950/70 border border-cyan-800/60 hover:border-cyan-500 hover:text-white transition-all group"
            >
              <span>DOI: 10.13140/RG.2.2.27355.49443</span>
              <ExternalLink class="w-3 h-3 text-cyan-400 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>

          <div class="space-y-1">
            <h4 class="text-base sm:text-lg font-bold text-white leading-snug">
              التحليل القياسي لتقارب أسعار المساكن الإقليمية في المملكة العربية السعودية
            </h4>
            <p class="text-xs font-mono text-slate-400" dir="ltr">
              Empirical Analysis of the Regional House Price Convergence in the Kingdom of Saudi Arabia
            </p>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed font-light">
            <strong class="text-slate-200">الجهة الأكاديمية:</strong> جامعة مرمرة (Marmara University) — إسطنبول، تركيا.
          </p>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            تطبيق منهجيات الاقتصاد القياسي المكاني واختبارات تقارب النوادي غير الخطية (Phillips & Sul) وسلاسل البيانات اللوحية الديناميكية (Dynamic Panel Data) لتفسير مسارات التقارب السعري العقاري بين مناطق المملكة.
          </p>
        </div>

        <!-- Paper 3: Islamic Finance (Bai Al-Inah & Al-Tawarruq) -->
        <div class="bg-slate-950/80 p-5 sm:p-6 rounded-2xl border border-slate-800/90 space-y-3 hover:border-amber-500/30 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/20">
                بحث محكّم (2020)
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Islamic Economics</span>
            </div>

            <!-- DOI Link -->
            <a
              href="https://doi.org/10.33423/jabe.v22i9.3674"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-mono text-amber-300 bg-amber-950/70 border border-amber-800/60 hover:border-amber-500 hover:text-white transition-all group"
            >
              <span>DOI: 10.33423/jabe.v22i9.3674</span>
              <ExternalLink class="w-3 h-3 text-amber-400 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>

          <div class="space-y-1">
            <h4 class="text-base sm:text-lg font-bold text-white leading-snug">
              رؤى ومقاربات فقهية واقتصادية حول صيغ بيع العينة والتورق في التمويل الإسلامي
            </h4>
            <p class="text-xs font-mono text-slate-400" dir="ltr">
              Islamic Scholars View on Bai Al-Inah and Al-Tawarruq
            </p>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed font-light">
            <strong class="text-slate-200">وعاء النشر:</strong> Journal of Applied Business and Economics (JABE), Vol. 22(9), pp. 126-136.
          </p>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            دراسة تحليلية مقارنة للأبعاد الفقهية والاقتصادية لصيغ التمويل الإسلامي المعاصر وتطبيقاتها في الأسواق المالية.
          </p>
        </div>
      </div>
    </section>

    <!-- 2 Columns Grid: Academic Foundation & Quantitative Toolkit -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Pillar 1: Academic Background -->
      <div class="glass-panel rounded-3xl p-6 sm:p-8 border-slate-800 hover:border-cyan-500/30 transition-all space-y-4">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-800">
          <div class="p-2.5 rounded-2xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
            <GraduationCap class="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">التأهيل الأكاديمي</h3>
            <span class="text-xs text-slate-400">الدراسة والتكوين المنهجي (100% باللغة الإنجليزية)</span>
          </div>
        </div>

        <div class="space-y-4 text-xs sm:text-sm">
          <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800/80 space-y-1.5">
            <div class="flex items-center justify-between text-cyan-300 font-semibold">
              <span>ماجستير في الاقتصاد والتمويل (MA)</span>
              <span class="text-[11px] font-mono text-slate-500">2019 – 2021</span>
            </div>
            <p class="text-slate-300 font-light">
              جامعة مرمرة (Marmara University)، معهد العلوم الاجتماعية — إسطنبول
            </p>
            <p class="text-[11px] text-slate-400 leading-relaxed font-light pt-1">
              تركيز مكثف على الاقتصاد القياسي المتقدم، النمذجة الرياضية الكلية والجزئية، وديناميكيات أسواق المال.
            </p>
          </div>

          <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800/80 space-y-1">
            <div class="flex items-center justify-between text-cyan-300 font-semibold">
              <span>بكالوريوس في التجارة الدولية والإدارة (BA)</span>
              <span class="text-[11px] font-mono text-slate-500">2014 – 2019</span>
            </div>
            <p class="text-slate-300 font-light">
              جامعة إسطنبول شهير (Istanbul Şehir University)، كلية العلوم الإدارية
            </p>
            <p class="text-[11px] text-slate-400 pt-1 font-light leading-relaxed">
              تأسيس كمي صارم في: الاقتصاد القياسي، نظرية الاقتصاد الجزئي، الجبر الخطي، وحساب التفاضل والتكامل.
            </p>
          </div>
        </div>
      </div>

      <!-- Pillar 2: Quantitative & Econometric Toolkit -->
      <div class="glass-panel rounded-3xl p-6 sm:p-8 border-slate-800 hover:border-emerald-500/30 transition-all space-y-4">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-800">
          <div class="p-2.5 rounded-2xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <Binary class="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">العدة القياسية والبرمجية</h3>
            <span class="text-xs text-slate-400">النمذجة الرياضية والتحليل الإحصائي المتقدم</span>
          </div>
        </div>

        <div class="space-y-3 text-xs sm:text-sm">
          <p class="text-slate-300 leading-relaxed font-light">
            تعتمد المنصة ونماذجها الرياضية الصرفة على خبرة عميقة في تحليل البيانات الاقتصادية التجريبية:
          </p>

          <div class="space-y-2.5">
            <div class="flex items-start gap-2.5 bg-slate-950/60 p-3 rounded-xl border border-slate-800">
              <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block text-xs mb-0.5">برمجيات وأدوات النمذجة القياسية:</strong>
                <span class="text-emerald-300 text-xs font-mono">
                  Python (pandas, numpy, scipy), Stata, R, EViews, SPSS
                </span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 bg-slate-950/60 p-3 rounded-xl border border-slate-800">
              <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block text-xs mb-0.5">المنهجيات القياسية المعتمدة:</strong>
                <span class="text-slate-400 text-[11px] leading-relaxed block">
                  نماذج الاختيار المتقطع (Discrete Choice Modeling)، تقييم أثر السياسات الاقتصادية (Difference-in-Differences, Event Study Designs)، الاقتصاد القياسي المكاني (Spatial Panels)، ونظرية التحكم الأمثل (Optimal Control Theory).
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Exploration CTA -->
    <section class="glass-panel border-cyan-500/30 bg-gradient-to-r from-cyan-950/40 via-slate-900 to-amber-950/30 rounded-3xl p-8 sm:p-12 text-center space-y-6 shadow-2xl relative overflow-hidden">
      <div class="max-w-2xl mx-auto space-y-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/30">
          <Compass class="w-3.5 h-3.5" />
          استكشف التجارب التفاعلية
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          خمس تجارب تفاعلية تعيد تعريف فهمك للاقتصاد
        </h3>
        <p class="text-slate-300 text-sm font-light leading-relaxed">
          انتقل من قراءة النظريات الجافة إلى معايشتها بيدك: وازن ساعات يومك في الواحة، ولاحظ كيف يتصرف الذهب عندما يتضاعف في الجزيرة، واحمِ المرعى المشترك من التصحر.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/chapters/1-currency-of-life"
