---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((chapter) => ({
    params: { slug: chapter.id.replace(/^0+/, '').replace(/\.mdx?$/, '') },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
---

<BaseLayout
  title={`${chapter.data.title} | منصة الاقتصاد الفطري`}
  description={chapter.data.description}
  currentChapter={`الفصل ${chapter.data.chapterNumber}: ${chapter.data.title}`}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <!-- Chapter Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-4">
      <a href="/" class="text-xs text-slate-400 hover:text-amber-300 transition-colors">
        الرئيسية
      </a>
      <span class="text-slate-600 text-xs">/</span>
      <span class="text-xs font-semibold text-amber-400">
        التجربة {chapter.data.chapterNumber}
      </span>
    </div>

    <!-- Chapter Header -->
    <header class="mb-10 pb-8 border-b border-slate-800">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {chapter.data.title}
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 font-light leading-relaxed">
        {chapter.data.description}
      </p>

      <!-- Concepts tags -->
      <div class="flex flex-wrap gap-2 mt-6">
        <span class="text-xs text-slate-400 py-1 pl-2">المفاهيم المكتشفة:</span>
        {chapter.data.concepts.map((concept) => (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300">
            {concept}
          </span>
        ))}
      </div>
    </header>

    <!-- MDX Content + Island Simulations -->
    <div class="prose prose-invert prose-amber max-w-none prose-headings:font-bold prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:text-slate-100 prose-h2:mt-12 prose-h2:mb-4 prose-p:text-slate-300 prose-p:leading-relaxed prose-p:text-base sm:prose-p:text-lg">
      <Content />
    </div>

    <!-- Chapter Navigation Footer -->
    <div class="mt-16 pt-8 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 transition-colors"
      >
        <span>← العودة لفهرس التجارب</span>
      </a>

      <div class="flex flex-wrap items-center gap-3">
        {chapter.data.chapterNumber === 2 && (
          <a
            href="/chapters/1-currency-of-life"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 transition-colors"
          >
            <span>التجربة 1: ميزانية نبضات اليوم →</span>
          </a>
        )}

        {chapter.data.chapterNumber === 3 && (
          <a
            href="/chapters/2-bread-and-gold"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 transition-colors"
          >
            <span>التجربة 2: جزيرة الرغيف والذهب →</span>
          </a>
        )}

        {chapter.data.chapterNumber === 4 && (
          <a
            href="/chapters/3-common-pasture"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 transition-colors"
          >
            <span>التجربة 3: لغز المرعى المشترك →</span>
          </a>
        )}

        {chapter.data.chapterNumber === 5 && (
          <a
            href="/chapters/4-borrowing-tomorrow"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 transition-colors"
          >
            <span>التجربة 4: استعارة طاقة الغد →</span>
          </a>
        )}

        {chapter.data.chapterNumber === 1 && (
          <a
            href="/chapters/2-bread-and-gold"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-amber-400 hover:bg-amber-300 text-slate-950 transition-colors"
          >
            <span>← الانتقال للتجربة 2: جزيرة الرغيف والذهب</span>
          </a>
        )}

        {chapter.data.chapterNumber === 2 && (
          <a
            href="/chapters/3-common-pasture"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-400 hover:bg-emerald-300 text-slate-950 transition-colors"
          >
            <span>← الانتقال للتجربة 3: لغز المرعى المشترك</span>
          </a>
        )}

        {chapter.data.chapterNumber === 3 && (
          <a
            href="/chapters/4-borrowing-tomorrow"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-cyan-400 hover:bg-cyan-300 text-slate-950 transition-colors"
          >
            <span>← الانتقال للتجربة 4: استعارة طاقة الغد</span>
          </a>
        )}

        {chapter.data.chapterNumber === 4 && (
          <a
            href="/chapters/5-whisper-in-the-market"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-purple-400 hover:bg-purple-300 text-slate-950 transition-colors"
          >
            <span>← الانتقال للتجربة 5: همسة في السوق</span>
          </a>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
