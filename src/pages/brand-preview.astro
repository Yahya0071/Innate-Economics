---
import BaseLayout from '../layouts/BaseLayout.astro';

const options = [
  {
    id: 'compass',
    title: 'الخيار 1: إبرة البوصلة الهندسية',
    sub: 'The Geometric Needle',
    concept: 'أبسط وأدق شكل للتعبير عن "البوصلة والاتجاه الرشيد". زاوية صعود 45 درجة (نمو ورؤية مستقبلية)، وجه ذهبي مشرق يعكس القيمة ووجه مظلل يعكس التوازن، مع نقطة ارتكاز دائرية نقية.',
    svgPath: '/brand/option1-compass.svg',
    file: 'option1-compass.svg',
    badge: 'الأكثر توازناً واحترافية'
  },
  {
    id: 'sprout',
    title: 'الخيار 2: بذرة الفطرة وقوس الصعود',
    sub: 'Sprout & Growth Arc',
    concept: 'يعبر مباشرة عن كلمة "الفطرة" من خلال ورقة نبات ناعمة منبثقة من خط صاعد متصل، يجمع بين الطبيعة الإنسانية والنمو الاقتصادي بخط واحد انسيابي.',
    svgPath: '/brand/option2-sprout.svg',
    file: 'option2-sprout.svg',
    badge: 'طبيعي وانسيابي'
  },
  {
    id: 'monogram',
    title: 'الخيار 3: مونوغرام حرف الفاء والتدفق',
    sub: 'The Circular Flow',
    concept: 'تجريد هندسي فائق البساطة لحرف (ف) من "فطرة"، مدمجاً في دائرة التدفق الاقتصادي للسلع والقيمة، مع نقطة التوازن المحورية المركزية.',
    svgPath: '/brand/option3-monogram.svg',
    file: 'option3-monogram.svg',
    badge: 'هندسي رمزي'
  },
  {
    id: 'delta',
    title: 'الخيار 4: سهم التوجيه والنمو',
    sub: 'The Navigation Delta',
    concept: 'مستوحى من أحدث لغات التصميم التكنولوجي السويسري (Fintech Modernism). سهم دقيق حاد يرمز لاتخاذ القرار المالي الصائب والانطلاق للأمام بأقل عدد خطوط ممكن.',
    svgPath: '/brand/option4-delta.svg',
    file: 'option4-delta.svg',
    badge: 'فائق البساطة والحدة'
  }
];
---

<BaseLayout title="استعراض خيارات الشعار المبسط | الاقتصاد الفطري">
  <main class="min-h-screen py-16 px-4 sm:px-6 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold mb-4">
        الهوية البصرية المبسطة
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        نماذج الشعار فائق البساطة (Minimalist Logos)
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        تم تصميم هذه الخيارات الأربعة بالاعتماد على التجريد التام، إزالة أي خطوط أو ظلال غير ضرورية، لضمان وضوح الشعار تماماً في المقاسات الصغيرة (Favicon والشريط العلوي) والكبيرة (LinkedIn والمشاريع).
      </p>
    </div>

    <!-- Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {options.map((opt, idx) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-semibold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
                {opt.badge}
              </span>
              <span class="text-xs text-slate-500 font-mono">0{idx + 1}</span>
            </div>

            <!-- Logo Preview Box -->
            <div class="flex items-center justify-center gap-6 p-8 rounded-2xl bg-slate-950 border border-slate-800/80 mb-6">
              <!-- Large Display (80px) -->
              <div class="w-20 h-20 shadow-2xl">
                <img src={opt.svgPath} alt={opt.title} class="w-full h-full object-contain" />
              </div>
              <!-- Small Nav/Favicon Simulation (36px) -->
              <div class="flex flex-col items-center gap-1.5">
                <div class="w-10 h-10 p-0.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center">
                  <img src={opt.svgPath} alt="small preview" class="w-full h-full object-contain" />
                </div>
                <span class="text-[10px] text-slate-500">حجم الشريط</span>
              </div>
            </div>

            <div class="mb-2">
              <h3 class="text-lg font-bold text-white inline-block">{opt.title}</h3>
              <span class="text-xs text-slate-400 font-sans mr-2" dir="ltr">({opt.sub})</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">{opt.concept}</p>
          </div>

          <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-500">{opt.file}</span>
            <span class="text-xs text-amber-300/80 font-medium">SVG متوفر</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Navbar Live Preview Banner -->
    <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
      <h4 class="text-sm font-semibold text-slate-300 mb-2">كيف يبدو الشعار المعتمد حالياً في أعلى الموقع؟</h4>
      <p class="text-xs text-slate-400">
        تم تفعيل <strong class="text-amber-400">الخيار 1 (البوصلة الهندسية)</strong> تلقائياً كشعار افتراضي في الشريط العلوي والأيقونة (Favicon)، ويمكننا التبديل فوراً لأي من الخيارات الأخرى حسب رغبتك.
      </p>
    </div>
  </main>
</BaseLayout>
